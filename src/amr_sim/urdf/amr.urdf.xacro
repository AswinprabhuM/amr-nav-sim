<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr">
  <xacro:property name="wheel_r" value="0.1"/>
  <xacro:property name="wheel_w" value="0.05"/>
  <xacro:property name="sep" value="0.34"/>
  <xacro:property name="caster_r" value="0.05"/>

  <xacro:macro name="box_inertial" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <link name="base_link">
    <visual><geometry><box size="0.5 0.3 0.12"/></geometry><material name="blue"><color rgba="0.2 0.3 0.8 1"/></material></visual>
    <collision><geometry><box size="0.5 0.3 0.12"/></geometry></collision>
    <xacro:box_inertial m="8" x="0.5" y="0.3" z="0.12"/>
  </link>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
      <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
      <inertial><origin rpy="1.5708 0 0"/><mass value="1"/>
        <inertia ixx="${(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" iyy="${(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" izz="${wheel_r*wheel_r/2}" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <!-- base_link origin is at wheel axle height (z = wheel_r above ground) -->
  <xacro:wheel name="left" y="${sep/2}"/>
  <xacro:wheel name="right" y="${-sep/2}"/>

  <link name="caster">
    <visual><geometry><sphere radius="${caster_r}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_r}"/></geometry>
      <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/><origin xyz="-0.2 0 ${-(wheel_r-caster_r)}"/>
  </joint>

  <link name="laser">
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="red"><color rgba="0.8 0.1 0.1 1"/></material></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser"/><origin xyz="0.15 0 0.1"/>
  </joint>

  <link name="imu_link">
    <inertial><mass value="0.01"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.07"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo reference="laser">
    <sensor name="laser" type="gpu_lidar">
      <gz_frame_id>laser</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <lidar>
        <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>10.0</max></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
</robot>
